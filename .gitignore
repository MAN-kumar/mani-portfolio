# Monorepo Root gitignore

# Python & Django
.venv/
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.sqlite3-journal

backend/.venv/
backend/.env
backend/.env.local
backend/db.sqlite3
backend/db.sqlite3-journal
backend/staticfiles/
backend/media/

# Node & Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env*.local
frontend/*.tsbuildinfo
frontend/.vercel/

# Logs & OS
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
